{
  "manifest_version": 3,
  "name": "Purificadoras Scout — flecha SV",
  "version": "1.5.0",
  "description": "REQUERIDA para auto-walk Scout: ArrowUp/Left/Right confiables vía chrome.debugger en Google Maps Street View. Companion de casca-code/mapa-purificadoras.",
  "permissions": ["debugger", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.google.com/maps*",
    "https://maps.google.com/*",
    "https://www.google.com.mx/maps*",
    "https://maps.google.com.mx/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://maps.google.com/*",
        "https://www.google.com.mx/maps*",
        "https://maps.google.com.mx/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Purificadoras Scout — extensión REQUERIDA para caminar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
